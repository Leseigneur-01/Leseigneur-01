+++ b/scripts/export-html.js
@@ -0,0 +1,67 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import React from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { format } from 'prettier';
+import { createServer } from 'vite';
+import react from '@vitejs/plugin-react';
+
+// Exporte la page d'accueil en HTML lisible, sans dupliquer les composants sources.
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const vite = await createServer({ root, configFile: false, plugins: [react()], optimizeDeps: { noDiscovery: true }, server: { middlewareMode: true, hmr: false }, appType: 'custom' });
+try {
+  const { default: App } = await vite.ssrLoadModule('/src/App.jsx');
+  const { default: QuoteModal } = await vite.ssrLoadModule('/src/QuoteModal.jsx');
+  const { default: BatModal } = await vite.ssrLoadModule('/src/BatModal.jsx');
+  const rendered = renderToStaticMarkup(React.createElement(App));
+  const content = rendered.replace(/^<link rel="preload" as="image"[^>]*\/>/, '');
+  // Gabarits inertes destinés à la lecture du code : React gère les vrais écrans.
+  const noop = () => {};
+  const quoteStates = [
+    ['devis-01-coordonnees', { initialStep: 1 }],
+    ['devis-02-conseil', { initialType: 'Conseil & création', initialStep: 2 }],
+    ['devis-02-petit-format', { initialType: 'Impression de supports', initialStep: 2, initialValues: { category: 'Petit format' } }],
+    ['devis-02-grand-format', { initialType: 'Impression de supports', initialStep: 2, initialValues: { category: 'Grand format / Signalétique' } }],
+    ['devis-03-petit-format', { initialType: 'Impression de supports', initialStep: 3, initialValues: { category: 'Petit format', format: 'Personnalisé' } }],
+    ['devis-03-grand-format', { initialType: 'Impression de supports', initialStep: 3, initialValues: { category: 'Grand format / Signalétique' } }],
+    ['devis-03-conseil', { initialType: 'Conseil & création', initialStep: 3 }],
+    ['devis-04-impression', { initialType: 'Impression de supports', initialStep: 4, initialValues: { delivery: 'Livraison sur site / Pose' } }],
+    ['devis-04-conseil', { initialType: 'Conseil & création', initialStep: 4 }],
+  ];
+  const templates = quoteStates.map(([id, props]) => `<template id="${id}">${renderToStaticMarkup(React.createElement(QuoteModal, { ...props, onClose: noop }))}</template>`).join('\n')
+    + `\n<template id="espace-bat">${renderToStaticMarkup(React.createElement(BatModal, { initialToken: '', onClose: noop }))}</template>`;
+  const html = `<!doctype html>
+<html lang="fr">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <meta name="theme-color" content="#f7f6ef" />
+    <meta name="description" content="Studio créatif et atelier d'impression à Abidjan : conseil, identité de marque, création graphique et impression sur mesure." />
+    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
+    <link rel="preload" as="image" href="/images/hero-print.webp" />
+    <link rel="stylesheet" href="/src/styles.css" />
+    <title>KORA — Studio créatif & atelier d’impression</title>
+  </head>
+  <body>
+    <!--
+      HTML de la page d'accueil généré depuis src/App.jsx.
+      Les filtres, le formulaire de devis, le contact et l'espace BAT sont
+      générés et gérés par les composants React et l'API Node du projet.
+      Les gabarits HTML inertes de leurs états figurent en fin de fichier.
+      Pour utiliser le site complet : npm install, puis npm run dev.
+      Régénérer ce fichier après une modification : npm run export:html.
+    -->
+    <noscript>Activez JavaScript pour utiliser les filtres, les formulaires et l’espace BAT.</noscript>
+    <div id="root">${content}</div>
+    <!-- Gabarits de lecture des écrans interactifs. Ils sont inertes : le site utilise les composants React. -->
+    ${templates}
+    <script type="module" src="/src/main.jsx"></script>
+  </body>
+</html>`;
+  const output = path.join(root, 'contenu-du-site.html');
+  await fs.writeFile(output, await format(html, { parser: 'html', printWidth: 110, htmlWhitespaceSensitivity: 'css' }), 'utf8');
+  console.log('HTML généré : contenu-du-site.html');
+} finally {
+  await vite.close();
+}
diff --git a/server/core.js b/server/core.js
new file mode 100644
index 0000000..fcbd296
--- /dev/null
+++ b/server/core.js
@@ -0,0 +1,188 @@
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+export const MAX_FILE_SIZE = 1024 * 1024 * 1024;
+export const ALLOWED_EXTENSIONS = new Set(['.pdf', '.ai', '.psd', '.indd']);
+export const PROJECT_TYPES = ['Conseil & création', 'Impression de supports', 'Projet 360°'];
+export const CATEGORIES = ['Petit format', 'Grand format / Signalétique'];
+export const SMALL_PRODUCTS = ['Brochure', 'Dépliant', 'Flyer', 'Affiche', 'Magazine', 'Carte de visite', 'Autre'];
+export const LARGE_PRODUCTS = ['Bâche', 'Roll-up', 'Enseigne', 'Autocollant', 'Covering', 'Autre'];
+export const SERVICES = ['Stratégie de marque', 'Identité visuelle', 'Création graphique / PAO', 'Contenus & digital', 'Autre'];
+export const SMALL_FINISHES = ['Dos carré collé', 'Piqûre métal', 'Plis simples', 'Pelliculage mat', 'Pelliculage brillant', 'Vernis sélectif'];
+export const FIXINGS = ['Tous les 50 cm', 'Aux 4 coins', 'Aucune'];
+
+const str = (value, max = 200) => typeof value === 'string' ? value.trim().slice(0, max) : '';
+const present = (value) => typeof value === 'string' && value.trim().length > 0;
+const inList = (value, list) => list.includes(value);
+const positiveNumber = (value) => Number.isFinite(Number(value)) && Number(value) > 0 && Number(value) <= 100000;
+const error = (message) => Object.assign(new Error(message), { status: 400 });
+
+export function validateQuote(raw) {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw error('La demande est invalide.');
+  if (present(raw.website)) throw error('La demande est invalide.');
+  const data = {
+    company: str(raw.company, 150), contact: str(raw.contact, 150),
+    email: str(raw.email, 254), phone: str(raw.phone, 32).replace(/[\s().-]/g, ''),
+    district: str(raw.district, 150), projectType: str(raw.projectType, 60),
+    category: str(raw.category, 80), product: str(raw.product, 100), service: str(raw.service, 100),
+    brief: str(raw.brief, 4000), format: str(raw.format, 30), customWidth: str(raw.customWidth, 20),
+    customHeight: str(raw.customHeight, 20), width: str(raw.width, 20), height: str(raw.height, 20),
+    paper: str(raw.paper, 60), grammage: str(raw.grammage, 20), printSide: str(raw.printSide, 30),
+    colors: str(raw.colors, 50), support: str(raw.support, 60), lamination: str(raw.lamination, 60),
+    finishings: Array.isArray(raw.finishings) ? raw.finishings.filter((v) => inList(v, SMALL_FINISHES)) : [],
+    fixings: Array.isArray(raw.fixings) ? raw.fixings.filter((v) => inList(v, FIXINGS)) : [],
+    quantity: raw.quantity === '' || raw.quantity == null ? null : Number(raw.quantity),
+    delivery: str(raw.delivery, 60), deliveryAddress: str(raw.deliveryAddress, 500), desiredDate: str(raw.desiredDate, 10), additionalDetails: str(raw.additionalDetails, 2000), consent: raw.consent === true,
+  };
+  if (!data.company || !data.contact) throw error('Renseignez le nom de l’entreprise et de votre contact.');
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) throw error('Renseignez une adresse e-mail valide.');
+  if (!/^\+225\d{10}$/.test(data.phone)) throw error('Le téléphone doit être au format +225 suivi de 10 chiffres.');
+  if (!inList(data.projectType, PROJECT_TYPES)) throw error('Choisissez un type de projet.');
+  if (!data.consent) throw error('Votre accord est nécessaire pour traiter votre demande.');
+  if (data.projectType === 'Conseil & création') {
+    if (!inList(data.service, SERVICES) || !data.brief) throw error('Précisez votre besoin en création et décrivez votre projet.');
+    return data;
+  }
