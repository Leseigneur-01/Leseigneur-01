# Serveur
PORT=5173
AGENCY_NAME=KORA Studio & Print
# Répertoire privé persistant, hors de public/ et dist/. Par défaut : var/private/.
# PRIVATE_STORAGE_DIR=/chemin/prive/kora
# URL publique HTTPS utilisée pour les liens BAT et fichiers en production.
# PUBLIC_BASE_URL=https://votre-domaine.ci
# À activer uniquement derrière exactement un proxy inverse de confiance.
TRUST_PROXY=0

# Coordonnées publiques (intégrées à la compilation Vite)
VITE_AGENCY_ADDRESS=
VITE_AGENCY_EMAIL=
VITE_AGENCY_PHONE=
VITE_AGENCY_HOURS=

# reCAPTCHA v3 : indispensable pour accepter les formulaires en production.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Facultatif si PUBLIC_BASE_URL est renseigné.
RECAPTCHA_EXPECTED_HOSTNAME=

# Administration : clé d'au moins 32 caractères, secret TOTP en base32 et IP autorisées.
ADMIN_API_KEY=
ADMIN_TOTP_SECRET=
ADMIN_ALLOW_IPS=

# Webhooks HTTPS : les adaptateurs CRM et messagerie sont à connecter séparément.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
PRODUCTION_WEBHOOK_URL=
PRODUCTION_WEBHOOK_SECRET=
